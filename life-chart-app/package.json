{
  "name": "life-chart-app",
  "version": "1.0.0",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:electron": "ELECTRON=true vite build",
    "electron": "ELECTRON_RUN_AS_NODE= NODE_ENV=development electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 npm run electron\"",
    "dist": "npm run build:electron && electron-builder --mac --dir",
    "dist:dmg": "npm run build:electron && electron-builder --mac"
  },
  "build": {
    "appId": "com.lifechart.app",
    "productName": "Life Chart",
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ]
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "electron": "^41.5.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "suncalc": "^1.9.0"
  }
}
